# Copy to .env (never commit .env). docker compose and the backend read these variables.

# Claude API key from https://console.anthropic.com/ (required for AI features)
ANTHROPIC_API_KEY=
# Point at dev/mock-claude.mjs to run without a key, e.g. http://localhost:8089
ANTHROPIC_BASE_URL=https://api.anthropic.com

# HS256 signing key for login tokens: at least 32 characters. Generate one with: openssl rand -base64 48
# If empty, a random key is used and everyone is signed out when the server restarts.
JWT_SECRET=

# Public address of the web app: links in confirmation and password-reset emails point here.
# (docker compose sets it to http://localhost:3000 itself.)
APP_BASE_URL=http://localhost:5173

# SMTP server for account emails (sign-up confirmation, password reset). Any provider works: SendGrid, Mailgun,
# Amazon SES, Azure Communication Services, Gmail with an app password...
#  - Not set: the backend prints the links in its log instead (handy for local development).
#  - docker compose: uses its bundled Mailpit inbox (http://localhost:8025) unless you set these.
# MAIL_HOST=smtp.sendgrid.net
# MAIL_PORT=587
# MAIL_USERNAME=apikey
# MAIL_PASSWORD=
# MAIL_STARTTLS=true
# MAIL_FROM=AI Interview Coach <no-reply@yourdomain.com>

# PostgreSQL (defaults match docker-compose.yml)
DB_URL=jdbc:postgresql://localhost:5432/coach
DB_USERNAME=coach
DB_PASSWORD=coach

# Cost protection for a public demo. A 30-question interview makes about 32 AI requests.
AI_DAILY_SPEND_CAP_USD=5.00
AI_REQUESTS_PER_USER_PER_DAY=150

# Comma-separated origins allowed to call the API from a browser (only needed when the frontend is hosted separately)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
